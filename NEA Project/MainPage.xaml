<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NEA_Project.MainPage"
             BackgroundColor="Transparent">

    <Grid Padding="0" RowDefinitions="*">
        <maps:Map x:Name="Map" 
                  IsShowingUser="True" 
                  IsTrafficEnabled="True"
                  Loaded = "MapLoaded"
                  />
        
        <Border ZIndex="20"
                Margin="30"
                Padding="14"
                BackgroundColor="#FAFFFFFF"
                Stroke="#10FFFFFF"
                StrokeThickness="1"
                HorizontalOptions="Fill"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,6"
                        Radius="20"
                        Opacity="0.18" />
            </Border.Shadow>
            
            <toolkit:Expander x:Name="DestinationExpander" ExpandedChanged = "DestinationExpander_ExpandedChanged">
                <toolkit:Expander.Header>
                    <Grid Padding="14" 
                          ColumnDefinitions="Auto,*,Auto"
                          VerticalOptions="Center">
                    
                    <BoxView Grid.Column="0"
                             WidthRequest="0"
                             HeightRequest="0"
                             CornerRadius="2"
                             BackgroundColor="#D1D5DB"
                             VerticalOptions="Center"
                             Margin="0,0,5,0"
                             />
                    
                    
                    <Label Grid.Column="1"
                           Text = "Where to next?"
                           FontSize="18"
                           TextColor = "#111827"
                           VerticalOptions="Center"/>
                    
                    <Label x:Name="Chevron"
                           Grid.Column="2"
                           Text="⌃"
                           FontSize="20"
                           TextColor="Black"
                           VerticalOptions="Center"/>
                    
                    </Grid>    
                </toolkit:Expander.Header>
                
                <toolkit:Expander.Content>
                    <VerticalStackLayout Padding="14" Spacing="10">
                        <Border BackgroundColor="#f3f4f6" StrokeThickness="0" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14">
                                </RoundRectangle>
                            </Border.StrokeShape>
                            <VerticalStackLayout>
                                <Entry x:Name="StartingEntry"
                                       Placeholder="Starting Location"
                                       ClearButtonVisibility="WhileEditing"
                                       ReturnType="Search"
                                       BackgroundColor="Transparent"
                                       TextColor="Black"
                                       Text="{Binding SearchText, Mode=TwoWay}"></Entry>
                                
                                <CollectionView
                                    ItemsSource="{Binding StartSuggestions}"
                                    SelectionMode="Single"
                                    SelectionChanged="SelectableItemsView_OnSelectionChanged"
                                    HeightRequest="150">
                                    
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8">
                                                <Label Text="{Binding Label}" FontAttributes="Bold" />
                                                <Label Text="{Binding Region}" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    
                                    
                                </CollectionView>
                                
                                <Entry x:Name = "DestinationEntry"
                                       Placeholder="Destination"
                                       Completed="DestinationEntry_OnCompleted"
                                       ClearButtonVisibility="WhileEditing"
                                       ReturnType="Search"
                                       BackgroundColor="Transparent"
                                       TextColor="Black"
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                >
                                </Entry>
                                
                                <CollectionView
                                    ItemsSource="{Binding EndSuggestions}"
                                    SelectionMode="Single"
                                    SelectionChanged="SelectableItemsView_OnSelectionChanged"
                                    HeightRequest="150">
                                    
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8">
                                                <Label Text="{Binding Label}" FontAttributes="Bold" />
                                                <Label Text="{Binding Region}" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    
                                </CollectionView>
                                
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
                
            </toolkit:Expander>
        </Border>
        
        <Button 
                x:Name = "RecenterButton"
                Clicked = "OnRecenterButtonClicked"
                ImageSource="location.svg"
                ContentLayout="Left,8"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="White"
                CornerRadius="18"
                Grid.RowSpan="1"  
                ZIndex="30">
            <Button.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,6"
                        Radius="20"
                        Opacity="0.18" />
            </Button.Shadow>
        </Button>
    </Grid>
    
</ContentPage>
